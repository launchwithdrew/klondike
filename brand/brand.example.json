{
  "_about": "Copy of what `clipengine init` writes to brand/brand.json. Every field is optional; missing ones use neutral defaults.",
  "name": "Your Channel",
  "accounts": {"youtube": {"handle": "@yourchannel", "channelId": ""}, "instagram": {"username": "yourchannel"}, "tiktok": {"username": "yourchannel"}},
  "hashtags": ["{creator}", "#yourcategory", "#yourchannel"],
  "layout": {"kind": "facecam", "split": 0.45},
  "max_hashtags": 3,
  "caption_style": "line+question",
  "card": {"show": true, "position": "seam", "fill": "#111827", "text": "#F9FAFB", "font": "InterDisplay-Bold.ttf", "size": 56, "radius": 12, "margin": 60, "max_lines": 3},
  "quote": {"show": true, "place": "below", "fill": "#F59E0B", "text": "#111827", "font": "InterDisplay-Bold.ttf", "size": 40, "radius": 10},
  "captions": {"font": "Inter Display", "font_file": "InterDisplay-Bold.ttf", "size": 72, "color": "#FFFFFF", "outline": "#000000", "outline_width": 5, "highlight": "#F59E0B", "words_per_card": 2, "y": 0.62, "uppercase": true},
  "logo": {"file": "brand/kit/logo.png", "corner": "bottom-right", "width": 220, "opacity": 0.75, "margin": 32},
  "voice": "brand/voice.md",
  "warmup": true
}
